<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tool="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground">


    <ImageView
        android:id="@+id/artWork_IV"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginVertical="@dimen/indent_small"
        android:layout_marginHorizontal="@dimen/indent_middle_compact"
        android:background="@drawable/rounded_rectangle_4"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        tool:src="@drawable/placeholder"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/name_Track_TV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/indent_small"
        android:ellipsize="end"
        android:maxLines="1"
        style="@style/TextAppearanceTitle3"
        app:layout_constraintBottom_toTopOf="@+id/artistName_TV"
        app:layout_constraintStart_toEndOf="@+id/artWork_IV"
        app:layout_constraintTop_toTopOf="@+id/artWork_IV"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintEnd_toStartOf="@+id/endIco_IV"
        tool:text="Yesterday (Remastered 2009) вреркеркркеркеркер" />

    <TextView
        android:id="@+id/artistName_TV"
        style="@style/TextAppearanceBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintBottom_toBottomOf="@+id/artWork_IV"
        app:layout_constraintEnd_toStartOf="@+id/trackTime_TV"
        app:layout_constraintStart_toStartOf="@+id/name_Track_TV"
        app:layout_constraintTop_toBottomOf="@+id/name_Track_TV"
        app:layout_constraintHorizontal_chainStyle="packed"
        tool:text="The Beatles" />

    <TextView
        android:id="@+id/trackTime_TV"
        style="@style/TextAppearanceBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/indent_extra_small"
        app:drawableStartCompat="@drawable/circle_13_13"
        app:drawableTint="@color/colorOnSecondaryVariant"
        app:layout_constraintBottom_toBottomOf="@+id/artistName_TV"
        app:layout_constraintEnd_toEndOf="@+id/name_Track_TV"
        app:layout_constraintStart_toEndOf="@+id/artistName_TV"
        app:layout_constraintTop_toTopOf="@+id/artistName_TV"
        tool:text="8888:88" />

    <ImageView
        android:id="@+id/endIco_IV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/indent_middle_compact"
        android:layout_marginStart="@dimen/indent_small"
        android:src="@drawable/forward_arrow_ico"
        android:backgroundTint="@color/colorOnSecondaryVariant"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>