<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorSecondary"
    tools:context=".SettingsActivity">


    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolBarBack_BTN"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleTextAppearance="@style/ToolBarTextAppearance"
        app:title="@string/search"
        app:navigationIcon="@drawable/arrow_left_alt_24" />


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/indent_middle"
        android:layout_marginVertical="@dimen/indent_small"
        android:paddingHorizontal="@dimen/indent_middle_compact"
        android:background="@drawable/search_background">


        <EditText
            android:id="@+id/searchEditText"
            style="@style/searchEditText"
            android:layout_marginEnd="@dimen/indent_big"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/search_ico" />

        <ImageView
            android:id="@+id/clear_BTN"
            android:layout_width="@dimen/icon_size_small"
            android:layout_height="@dimen/icon_size_small"
            android:layout_gravity="end|center_vertical"
            app:tint="@color/search_icon_tint"
            android:scaleType="centerInside"
            android:src="@drawable/clear_ico"
            android:visibility="invisible"
            tools:visibility="visible"
            />
    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/trackList_RV"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingVertical="@dimen/indent_middle"
        tools:listitem="@layout/item_track"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>




</LinearLayout>