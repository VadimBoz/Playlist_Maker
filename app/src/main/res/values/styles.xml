<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextAppearanceButtonBig" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">@font/yandex_sans</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="ButtonBig" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:textColor">@color/grey_dark</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/indent_small</item>
        <item name="iconTint">@color/grey_dark</item>
        <item name="iconSize">24dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:layout_marginVertical">@dimen/indent_small</item>
        <item name="android:layout_marginHorizontal">@dimen/indent_middle</item>
        <item name="rippleColor">@color/grey</item>
        <item name="android:textAppearance">@style/TextAppearanceButtonBig</item>
    </style>

    <style name="GeneralButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:backgroundTint">@color/surfacePrimary</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="cornerRadius">54dp</item>
        <item name="android:paddingVertical">@dimen/indent_middle_compact</item>
        <item name="android:paddingHorizontal">@dimen/indent_middle</item>
        <item name="android:layout_marginVertical">@dimen/indent_small</item>
        <item name="android:layout_marginHorizontal">@dimen/indent_middle</item>
        <item name="rippleColor">@color/grey</item>
        <item name="android:textAppearance">@style/TextAppearanceTitle</item>
    </style>

    <style name="TextAppearanceTitle3" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/yandex_sans</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearanceBody" parent="TextAppearance.AppCompat.Body2">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/colorOnSecondaryVariant</item>
        <item name="android:fontFamily">@font/yandex_sans</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearanceTitle" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">@color/warning_text</item>
        <item name="android:fontFamily">@font/yandex_sans</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:gravity">center</item>
    </style>


    <style name="TextButtonSettings" parent="Widget.MaterialComponents.TextView">
        <item name="android:paddingVertical">@dimen/indent_middle</item>
        <item name="android:paddingHorizontal">@dimen/indent_middle</item>
        <item name="android:stateListAnimator">"@null"</item>
        <item name="android:background">@color/colorSecondary</item>
        <item name="android:textColor">@color/colorOnSecondary</item>
        <item name="drawableTint">@color/colorOnSecondaryVariant</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="rippleColor">@color/grey</item>
        <item name="android:textAppearance">@style/TextAppearanceTitle3</item>
    </style>


    <style name="ToolBarTextAppearance" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">22sp</item>
        <item name="fontFamily">@font/yandex_sans</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:letterSpacing">0</item>
    </style>


    <style name="MaterialToolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">@color/colorSecondary</item>
        <item name="titleTextColor">@color/colorOnSecondary</item>
        <item name="titleMarginStart">@dimen/indent_extra_small</item>
        <item name="contentInsetStartWithNavigation">0dp</item>
        <item name="navigationIconTint">@color/colorOnSecondary</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:elevation">0dp</item>
    </style>


    <style name="searchEditText" parent="Widget.AppCompat.EditText">
        <item name="backgroundTint">@color/grey_very_light</item>
        <item name="android:textColor">@color/search_edit_text</item>
        <item name="android:drawableTint">@color/search_icon_tint</item>
        <item name="android:hint">@string/search</item>
        <item name="android:inputType">text</item>
        <item name="android:textColorHint">@color/search_hint_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/yandex_sans</item>
        <item name="android:fontWeight">400</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">36dp</item>
        <item name="maxLines">1</item>
        <item name="singleLine">true</item>
        <item name="android:drawablePadding">@dimen/indent_small</item>
    </style>


</resources>