<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ButtonBig" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">@font/yandexsansdisplay_medium</item>
        <item name="backgroundTint">@color/white</item>
        <item name="android:textColor">@color/dark_gey</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconTint">@color/dark_gey</item>
        <item name="iconSize">24dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:layout_marginVertical">4dp</item>
        <item name="rippleColor">@color/grey_light</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="ButtonSettings" parent="Widget.MaterialComponents.Button">
        <item name="android:paddingVertical">@dimen/indent_middle</item>
        <item name="android:paddingHorizontal">@dimen/indent_middle</item>
        <item name="android:stateListAnimator">"@null"</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/yandexsans</item>
        <item name="android:textFontWeight">400</item>
        <item name="backgroundTint">@color/white</item>
        <item name="android:textColor">@color/dark_gey</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAlignment">textStart</item>
        <item name="iconGravity">end</item>
        <item name="iconTint">@color/grey</item>
        <item name="iconSize">24dp</item>
        <item name="android:layout_marginVertical">4dp</item>
        <item name="rippleColor">@color/grey_light</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>









    <style name="ClickableIcon">
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

</resources>